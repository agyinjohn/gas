{
  "name": "@getgas/rider-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --offline",
    "start": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --offline",
    "dev:online": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start",
    "android": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --android",
    "ios": "cross-env NODE_OPTIONS=--no-experimental-strip-types expo start --ios",
    "lint": "expo lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@getgas/config": "*",
    "@getgas/domain": "*",
    "@getgas/mobile-core": "*",
    "@getgas/mobile-ui": "*",
    "@getgas/types": "*",
    "@tanstack/react-query": "^5.32.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "cross-env": "^7.0.3",
    "typescript": "^5.4.5"
  }
}
