# Backend API (same machine running `npm run dev` in backend/)
# Use your PC's LAN IP — NOT the Expo Metro IP, and the same IP for both apps.
# Example: if Expo shows exp://192.168.100.2:8081, your API is usually:
EXPO_PUBLIC_API_URL=http://192.168.100.2:4000
EXPO_PUBLIC_SOCKET_URL=http://192.168.100.2:4000
